<?xml version="1.0" encoding="UTF-8"?>
<!-- version-sentinel launchd 捕获哨（W-VERSIONREVERT，1105）
     实装位：~/Library/LaunchAgents/online.humumu.ccdeck.version-sentinel.plist
     语义：WatchPaths 盯 App 的 Info.plist（.app 整体交换必 touch）+ RunAtLoad（会话
     启动即检一次=启动自检部署态）。触发即跑 scripts/version-sentinel.sh：版本/指纹
     变化 → 告警账 ~/.cc-deck/data/version-revert-log.ndjson + ps 现场快照 +
     /api/notify 黄框推手机。与 relay 单实例纪律无冲突（独立哨进程，不碰 8787 监听）。
     部署/卸载：
       cp deploy/online.humumu.ccdeck.version-sentinel.plist ~/Library/LaunchAgents/
       launchctl unload ~/Library/LaunchAgents/online.humumu.ccdeck.version-sentinel.plist 2>/dev/null
       launchctl load ~/Library/LaunchAgents/online.humumu.ccdeck.version-sentinel.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>online.humumu.ccdeck.version-sentinel</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__CC_DECK_REPO__/scripts/version-sentinel.sh</string>
  </array>
  <key>WatchPaths</key>
  <array>
    <string>/Applications/CC Deck Nova.app/Contents/Info.plist</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardErrorPath</key><string>/tmp/cc-deck-version-sentinel.err</string>
</dict>
</plist>
