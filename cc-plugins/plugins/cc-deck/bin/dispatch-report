#!/bin/bash
# dispatch-report：派单审计账对账巡检（#018-C2，018 :424 验收口径）。
# 读 cli-dispatches.ndjson（bin/dispatch 的 append-only 审计账）做四类判定：
#   timeout   ok:false 且 error 属超时/连不上/断线类且 attempt:2 仍败 = 短重试用尽
#             终态（C1 已转人工，此处列待处置清单）
#   orphan    某 command_id 全部行均 ok:false（无任何有效 ACK）= 派单未达无人认领，
#             待人工重投
#   duplicate 同 command_id 出现 ≥2 条 ok:true 行（relay 幂等回放防双投，审计面仍
#             是重复迹象）；同 dispatch_id 跨 command_id（换新 id 违 C1 纪律迹象）
#   seq-gap   审计账无 seq 字段的代位判定：坏行（非 JSON/缺关键字段/类型错）计数
#             报行号 + ts 倒序（时钟回拨/并发写异常）报行号。代位备案：append-only
#             NDJSON 无序号，018 :235 seq-gap 口径在 events 流面，CLI 审计面以
#             「行完整性+时序单调」代位；V1 若 events 侧需要可另接
# ACK 误读防护：成功统计与 orphan/timeout 判定只认 ok 严格布尔真——ok:"yes"/"1"/
# "true"（字符串）或缺省一律不算成功，按坏行（ACK 误读态）计数，绝不进成功账。
# 行完整性（C2fix/P2-1）：error 字段必在场且为 null|string（C1 schema 恒写）——
# 缺省/类型错计坏行报行号，不进 orphan/timeout 语义分类（坏行不臆断未达）。
# DELIVER 行（deliver HTTP 直投）无状态机，不入本对账面（失败回退属 C3 线）。
# 环境注入（#018-C1 文档化）：离线审计读者，只需 CCR_DATA_DIR（或位置参数显式账本
# 路径）；不读 CCR_TOKEN/CCR_PORT（不对 relay 建连）。
# timeout/orphan 项携带 dispatch_ids（#018-C1：PM 对账三 ID 键对齐 cli-dispatches
# 行与控制台 phase 日志——grep '"dispatch_id":"<id>"' 一套键贯穿）。
# 用法: dispatch-report [--json] [--strict] [账本路径]
#   --json    机器可读 {counts, items, verdict}
#   --strict  duplicate/seq-gap 升级为非零退出（缺省仅 warn）
#   账本缺省 $CCR_DATA_DIR/cli-dispatches.ndjson（未设 CCR_DATA_DIR 时 ~/.cc-deck/data）
# 退出码：0=账干净或仅 warn；1=orphan/timeout 待处置（--strict 下含 duplicate/seq-gap）；
#         2=用法错误/账本不存在（不静默谎报干净）
set -uo pipefail

usage() {
  echo "用法: dispatch-report [--json] [--strict] [账本路径]" >&2
  echo "  账本缺省 \$CCR_DATA_DIR/cli-dispatches.ndjson（未设 CCR_DATA_DIR 时 ~/.cc-deck/data）" >&2
  echo "  --json 机器可读；--strict 把 duplicate/seq-gap 升级为非零退出" >&2
  exit 2
}

json_mode=0
strict=0
ledger=""
while [ $# -gt 0 ]; do
  case "$1" in
    --json) json_mode=1 ;;
    --strict) strict=1 ;;
    -h|--help) usage ;;
    -*) usage ;;
    *)
      [ -z "$ledger" ] || usage
      ledger="$1"
      ;;
  esac
  shift
done
[ -n "$ledger" ] || ledger="${CCR_DATA_DIR:-$HOME/.cc-deck/data}/cli-dispatches.ndjson"

exec python3 - "$ledger" "$json_mode" "$strict" <<'PY'
import json
import os
import sys
from datetime import datetime

ledger = sys.argv[1]
json_mode = sys.argv[2] == "1"
strict = sys.argv[3] == "1"

if not os.path.isfile(ledger):
    print(f"dispatch 巡检失败：账本不存在：{ledger}（未发生过派单？路径设错？——不静默谎报干净）", file=sys.stderr)
    sys.exit(2)

# C1 三态（exit 11 连不上/断线、12 超时）对应的 error 文本类；匹配用子串——
# 10（relay 明确拒收）与 bash 前置失败（缺 token/payload 坏）不属此类，落 orphan
TIMEOUT_CLASS = ("超时", "无法连接", "握手失败", "关闭了 WS 连接", "连接意外关闭")


def parse_ts_ms(ts):
    """ISO 字符串（含 Z）或 epoch 数值 → 毫秒；不可解析返回 None"""
    if isinstance(ts, bool):
        return None
    if isinstance(ts, (int, float)):
        return ts if ts > 1e11 else ts * 1000  # 秒级数值容错升毫秒
    if isinstance(ts, str) and ts:
        try:
            return datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp() * 1000
        except (ValueError, TypeError):
            return None
    return None


rows_total = 0
valid = []          # 结构可信行（语义分类只用这些）
bad = []            # seq-gap：坏行 {line, reason}
deliver_rows = 0
misread_rows = 0    # ok 缺省/非布尔——ACK 误读态（坏行子集，绝不进成功账）

with open(ledger, encoding="utf-8") as f:
    for lineno, raw in enumerate(f, 1):
        line = raw.strip()
        if not line:
            continue
        rows_total += 1
        try:
            obj = json.loads(line)
        except (json.JSONDecodeError, ValueError):
            bad.append({"line": lineno, "reason": "非 JSON"})
            continue
        if not isinstance(obj, dict):
            bad.append({"line": lineno, "reason": "非 JSON 对象"})
            continue
        errs = []
        rtype = obj.get("type")
        for field in ("session_id", "dispatch_id", "type"):
            v = obj.get(field)
            # DELIVER 行允许 session_id 空串：deliver 三级归因全缺时已 stderr 警告、
            # 空值如实落账（合法状态非损坏）；COMMAND_MESSAGE 仍严判（dispatch 用法
            # 强制 session_id 位置参数，空串只可能是坏行）
            if not isinstance(v, str) or (not v and not (field == "session_id" and rtype == "DELIVER")):
                errs.append(f"缺/错字段 {field}")
        if isinstance(rtype, str) and rtype not in ("COMMAND_MESSAGE", "DELIVER"):
            errs.append(f"未知 type（{rtype}）")
        # ok 严格布尔：缺省/字符串/数字全是 ACK 误读态——不算成功，也不臆断失败
        if "ok" not in obj:
            errs.append("缺字段 ok（ACK 误读态）")
        elif not isinstance(obj["ok"], bool):
            errs.append(f"ok 类型错（{json.dumps(obj['ok'], ensure_ascii=False)}，非布尔——ACK 误读态）")
        # error 必在场且为 null|string（C2fix/P2-1：C1 写账 schema 恒写 error——成功
        # null、失败字符串）——缺省即坏行：损坏/截断行（如 ok:false 且缺 error）不得
        # 混进 valid 被臆断成 orphan「未达」而误触发重投（坏行不进语义分类）
        if "error" not in obj:
            errs.append("缺字段 error")
        elif not (obj["error"] is None or isinstance(obj["error"], str)):
            errs.append("错字段 error")
        if rtype == "COMMAND_MESSAGE":
            cid = obj.get("command_id")
            if not isinstance(cid, str) or not cid:
                errs.append("缺/错字段 command_id")
            att = obj.get("attempt")
            if isinstance(att, bool) or not isinstance(att, int) or att < 1:
                errs.append("缺/错字段 attempt")
        ts_ms = parse_ts_ms(obj.get("ts"))
        if ts_ms is None:
            errs.append("缺/错字段 ts")
        if errs:
            bad.append({"line": lineno, "reason": "；".join(errs)})
            if "ok" not in obj or not isinstance(obj.get("ok"), bool):
                misread_rows += 1
            continue
        if rtype == "DELIVER":
            deliver_rows += 1  # HTTP 直投无状态机，不入四类对账（C3 线备案）
        valid.append({
            "line": lineno, "ts_ms": ts_ms, "type": rtype,
            "session_id": obj["session_id"], "dispatch_id": obj["dispatch_id"],
            "command_id": obj.get("command_id"), "ok": obj["ok"],
            "error": obj.get("error"), "attempt": obj.get("attempt"),
        })

# seq-gap 代位之二：ts 单调性（只比行间先后，不取当下时钟——无 Date.now 依赖）
ts_regressions = []
prev = None
for r in valid:
    if prev is not None and r["ts_ms"] < prev["ts_ms"]:
        ts_regressions.append({"line": r["line"], "reason": f"ts 倒序（前一行 L{prev['line']}）"})
    prev = r

# 语义分类（仅 COMMAND_MESSAGE 有效行；DELIVER 已排除）
by_cmd = {}
for r in valid:
    if r["type"] == "COMMAND_MESSAGE":
        by_cmd.setdefault(r["command_id"], []).append(r)

timeout_items = []
orphan_items = []
dup_cmd_items = []
success_commands = 0
for cmd, rs in by_cmd.items():
    oks = [r for r in rs if r["ok"] is True]
    lines = [r["line"] for r in rs]
    last = rs[-1]
    if oks:
        success_commands += 1
        if len(oks) >= 2:
            dup_cmd_items.append({
                "kind": "command_id", "command_id": cmd,
                "lines": [r["line"] for r in oks],
                "dispatch_ids": sorted({r["dispatch_id"] for r in oks}),
                "session_id": last["session_id"],
                "note": "同 command_id 多条有效 ACK（relay 幂等回放防双投，请核验是否真双投）",
            })
        continue
    # 无任何有效 ACK：全失败行——按 error 类分 timeout 终态 / orphan
    terminal = any(
        r["attempt"] is not None and r["attempt"] >= 2
        and any(k in (r["error"] or "") for k in TIMEOUT_CLASS)
        for r in rs
    )
    item = {
        "command_id": cmd, "lines": lines,
        "session_id": last["session_id"],
        "dispatch_ids": sorted({r["dispatch_id"] for r in rs}),
        "attempt": last["attempt"],
        "error": last["error"] or "",
    }
    (timeout_items if terminal else orphan_items).append(item)

# 同 dispatch_id 跨 command_id（换新 id = 违 C1「不换新 id」纪律的迹象）
by_disp = {}
for r in valid:
    if r["type"] == "COMMAND_MESSAGE":
        by_disp.setdefault(r["dispatch_id"], set()).add(r["command_id"])
dup_disp_items = [
    {"kind": "dispatch_id", "dispatch_id": d, "command_ids": sorted(cids),
     "note": "同 dispatch_id 跨 command_id（换新 id 违 C1 纪律迹象）"}
    for d, cids in sorted(by_disp.items()) if len(cids) > 1
]

counts = {
    "rows": rows_total,
    "valid_rows": len(valid),
    "deliver_rows": deliver_rows,
    "bad_rows": len(bad),
    "ack_misread_rows": misread_rows,
    "ts_regressions": len(ts_regressions),
    "timeout": len(timeout_items),
    "orphan": len(orphan_items),
    "duplicate_commands": len(dup_cmd_items),
    "duplicate_dispatches": len(dup_disp_items),
    "success_commands": success_commands,
}

dup_all = dup_cmd_items + dup_disp_items
seqgap_all = bad + ts_regressions
blocking = counts["timeout"] + counts["orphan"]
warnable = len(dup_all) + len(seqgap_all)
if blocking or (strict and warnable):
    verdict = "fail"
elif warnable:
    verdict = "warn"
else:
    verdict = "clean"

items = {
    "timeout": timeout_items,
    "orphan": orphan_items,
    "duplicate": dup_all,
    "seqgap": seqgap_all,
}

if json_mode:
    print(json.dumps({"counts": counts, "items": items, "verdict": verdict},
                     ensure_ascii=False, indent=2))
else:
    print(f"dispatch 巡检（C2 对账）：{ledger}")
    print(f"共 {counts['rows']} 行：有效 {counts['valid_rows']}（内 DELIVER {counts['deliver_rows']} 不入对账）/ 坏行 {counts['bad_rows']}")
    print(f"① timeout（重试用尽待处置）：{counts['timeout']}")
    for it in timeout_items:
        print(f"   - L{it['lines'][-1]} command_id={it['command_id']} session_id={it['session_id']} dispatch_id={','.join(it['dispatch_ids'])} attempt:{it['attempt']} error={it['error']}")
    print(f"② orphan（未达待人工重投）：{counts['orphan']}")
    for it in orphan_items:
        print(f"   - L{it['lines'][0]} command_id={it['command_id']} session_id={it['session_id']} dispatch_id={','.join(it['dispatch_ids'])} error={it['error']}")
    print(f"③ duplicate（重复迹象待核验）：{len(dup_all)}")
    for it in dup_all:
        if it["kind"] == "command_id":
            print(f"   - command_id={it['command_id']} 成功行 L{it['lines']} dispatch={it['dispatch_ids']}")
        else:
            print(f"   - dispatch_id={it['dispatch_id']} 跨 command_id {it['command_ids']}")
    print(f"④ seq-gap（行完整性/时序代位）：坏行 {counts['bad_rows']} + 倒序 {counts['ts_regressions']}")
    for it in seqgap_all:
        print(f"   - L{it['line']} {it['reason']}")
    if verdict == "fail" and blocking:
        print("结论：fail——orphan/timeout 待处置，转人工巡检（重投前先核台账，勿自动重复派单）")
    elif verdict == "fail":
        # C2fix/P3-1：strict 下仅 duplicate/seq-gap 升级的 fail——对账异常话术，
        # 不喊重投（无 orphan/timeout 时「待处置重投」文案会误导操作员重复派单）
        print("结论：fail——对账异常（duplicate/seq-gap 待人工核验；无 orphan/timeout，无需重投）")
    elif verdict == "warn":
        print("结论：warn——duplicate/seq-gap 待人工核验（--strict 可升级为非零退出）")
    else:
        print("结论：clean——账面干净（四类零发现）")

sys.exit(1 if verdict == "fail" else 0)
PY
