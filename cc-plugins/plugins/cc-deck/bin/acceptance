#!/usr/bin/env python3
# 验收单出单工具（#136 三步方案①，激活 #125 在线表单）：把四段结构验收单 md 登记为
# data/acceptances/<id>.json，回吐在线表单链接（浏览器打开点选填写，结果落
# <id>.results.json）。用法：acceptance <验收单.md>。md 解析规则（对齐全局验收单
# 四段结构，宽容解析）：第一个 "# " 行=标题；首个表格前的其余非空行=前置说明
# （去 "- " 列表符）；表格行 "| 任务号 | 验收项 | 通过标准 | … |" 取前三列（通过
# 与否/问题两列是留给用户填的，忽略），表头与 --- 分隔行自动跳过；表格后的非空行
# =备注。同 md 重复出单=新 id 新单（旧单历史留痕不清理；改了 md 就重新出一张）。
#
# #28 云通道密钥（2026-10-01）：出单时另生成 per-sheet 密钥上传 KV
#（acceptance-<id>.key，仅 Worker 对照用、HTTP 白名单永不可读），云链接以
# fragment（#<key>）携带——fragment 不进服务器日志/Referer/缓存键，页面提交时
# 带回 Worker 验证。目的：id（页面链接）泄露 ≠ 可伪造提交（此前拿到 id 即可
# 伪造全 ✓ → relay 拉回假关单）。key 上传失败则不吐云链接（LAN 不受影响）——
# 防止「页面在云上但谁也提交不了」的半残单。
import json, os, re, secrets, subprocess, sys, time

md = sys.argv[1] if len(sys.argv) > 1 else ""
if not md or not os.path.isfile(md):
    sys.exit("用法: acceptance <验收单.md>")

lines = open(md, encoding="utf-8").read().splitlines()
title, preface, rows, notes = "", [], [], []
in_table = False
for ln in lines:
    s = ln.strip()
    if not s:
        continue
    if not title and s.startswith("# "):
        title = s[2:].strip()
        continue
    if s.startswith("#"):  # ## 小节头（前置/验收表/备注）是结构标记，不进内容
        continue
    if s.startswith("|"):
        in_table = True
        cells = [c.strip() for c in s.strip("|").split("|")]
        if len(cells) < 3:
            continue
        if all(re.fullmatch(r":?-{2,}:?", c) for c in cells if c):  # 分隔行
            continue
        if "任务号" in cells[0] or "验收项" in cells[1]:  # 表头
            continue
        rows.append({"task": cells[0], "item": cells[1], "criteria": cells[2]})
        continue
    (notes if in_table else preface).append(re.sub(r"^[-*] ", "", s))

if not rows:
    sys.exit("ERR: 未解析到验收表行（找 | 任务号 | 验收项 | 通过标准 | 形态的表格）")
title = title or os.path.basename(md)

# 寻址 env 优先序（#36 M2 并行版，2026-10-03，F-09 deliver/org 同款）：CCR_DATA_DIR
# 缺省回落生产路径；M2 会话由 relay spawn 继承 env 路由到 ~/.cc-deck-m2，生产无 env
# 时逐字节同行为
data_dir = os.environ.get("CCR_DATA_DIR") or os.path.join(
    os.path.expanduser("~"), ".cc-deck", "data")
acc_dir = os.environ.get("CCR_ACCEPTANCE_DIR") or os.path.join(data_dir, "acceptances")
os.makedirs(acc_dir, exist_ok=True)
aid = secrets.token_hex(16)
# #28 per-sheet 密钥：与 KV 上 acceptance-<id>.key 同值落本地 json（sheet_key）——
# relay 随 SNAPSHOT 汇总下发已配对端（expo 云卡拼 #key）；表单页 DATA 不嵌（公开读面）
skey = secrets.token_hex(16)
# 会话身份沿用 deliver 的注入优先级：Claude Code 子进程通常有
# CLAUDE_CODE_SESSION_ID；hook/显式转发场景用 CC_DECK_SESSION_ID；手动终端为空。
sid = (os.environ.get("CC_DECK_SESSION_ID") or os.environ.get("CLAUDE_CODE_SESSION_ID") or
       os.environ.get("CLAUDE_SESSION_ID") or "").strip()
doc = {"id": aid, "title": title, "created_at": int(time.time()),
       # cwd=出单会话归因键（#138）：用户提交后 relay 按它把「3✓ 1✗ 2未测」摘要
       # 回流成该会话的 system 行；旧单没这字段=回流静默跳过
       "cwd": os.getcwd(),
       "sheet_key": skey,
       "rows": rows, **({"preface": preface} if preface else {}),
       **({"notes": notes} if notes else {}),
       **({"session_id": sid} if sid else {})}
path = os.path.join(acc_dir, f"{aid}.json")
with open(path, "w", encoding="utf-8") as f:
    json.dump(doc, f, ensure_ascii=False, indent=1)

# 端口以 relay 自报为准（bridge.json），缺省 8787（同 deliver 口径）。env 优先序：
# CCR_PORT > bridge.json > 8787（#36 M2 并行版路由，缺省逐字节同行为）
if os.environ.get("CCR_PORT"):
    port = os.environ["CCR_PORT"]
else:
    port = "8787"
    try:
        port = str(json.load(open(os.path.expanduser("~/.cc-deck/data/bridge.json")))["port"])
    except Exception:
        pass
ip = "127.0.0.1"
for iface in ("en0", "en1"):
    try:
        out = subprocess.run(["ipconfig", "getifaddr", iface], capture_output=True, text=True).stdout.strip()
        if out:
            ip = out
            break
    except Exception:
        pass

print(f"✅ 已登记 {len(rows)} 行：{path}")
print(f"   填写链接(家庭网): http://{ip}:{port}/acceptance/{aid}")

# #175 云通道：从本地 relay 拉云版表单页（提交端点烙成 CF /view/acceptance-<id>.results.json）
# 上传 KV——公司网浏览器经 https://cc.humumu.online/view/acceptance-<id>.html#<key> 打开提交，
# 家庭 relay 每 60s 拉回结果。云端上传失败仍保留 LAN 链接，但命令非零提醒补投。
# #28 顺序：密钥先传成功才传页面/吐云链接（key 缺失的云页面=部署后谁都提交不了）。
html_path = f"/tmp/acceptance-{aid}.html"
key_path = f"/tmp/acceptance-{aid}.key"
cloud_failed = False
# 上传脚本用 m1 worktree 副本（#28：回读校验改 CF API 直读，不再依赖公网 /dl/——
# /dl/ 已拒 .key 键；旧 checkout 副本无此改造且该目录属 peer 地盘不动）
KVPUT = "/Users/xdd/dev/cc-deck-m1/scripts/kv-put-verified.sh"
try:
    with open(key_path, "w", encoding="utf-8") as f:
        f.write(skey)
    # #29（D-P2）：per-sheet 密钥是 32 位提交通行证——落 /tmp 期间最小权限（默认
    # 644 同机其他账户可读），且无论上传成败用完即删（finally 兜异常路径）
    os.chmod(key_path, 0o600)
    kv_key = subprocess.run([KVPUT, key_path, f"acceptance-{aid}.key"],
                            capture_output=True, text=True, errors="replace")
    if kv_key.returncode != 0:
        cloud_failed = True
        print(f"   ❌ 密钥上传失败，云通道未发布（家庭网链接仍可用，请修复网络后重试）：{(kv_key.stdout + kv_key.stderr).strip()[:200]}")
    else:
        try:
            page = subprocess.run(["curl", "-sS", "--max-time", "10", "-o", html_path,
                                   "-w", "%{http_code}",
                                   f"http://127.0.0.1:{port}/acceptance-cloud/{aid}"],
                                  check=True, capture_output=True, text=True, errors="replace")
            status = page.stdout.strip()
            if status != "200":
                raise RuntimeError(f"HTTP {status}")
            raw_page = open(html_path, encoding="utf-8").read().strip()
            if not raw_page:
                raise RuntimeError("响应体为空")
            try:
                ack = json.loads(raw_page)
            except json.JSONDecodeError:
                ack = None
            if isinstance(ack, dict) and ack.get("ok") is not True:
                raise RuntimeError(f"ACK ok 非 true：{ack.get('error') or '未知错误'}")
        except Exception as e:
            cloud_failed = True
            print(f"   ❌ 云端表单页获取失败（{e}，请确认 relay 在线后重试；家庭网链接仍可用）")
        # errors="replace"：脚本输出偶带非 UTF-8 字节（代理报错混入），text=True 严格解码
        # 会把真实失败原因吞成 UnicodeDecodeError；上传失败只做一次快速重试，最终非零退出
        kv = None
        if not cloud_failed:
            for attempt in (1, 2):
                kv = subprocess.run([KVPUT, html_path, f"acceptance-{aid}.html"],
                                    capture_output=True, text=True, errors="replace")
                if kv.returncode == 0:
                    break
                if attempt == 1:
                    print("    云端上传失败（网络抖动），请确认网络后自动重试一次…")
            if kv and kv.returncode == 0:
                print(f"   填写链接(公司网): https://cc.humumu.online/view/acceptance-{aid}.html#{skey}")
            else:
                cloud_failed = True
                detail = (kv.stdout + kv.stderr).strip()[:200] if kv else "未执行上传"
                print(f"   ❌ 云端上传失败（家庭网链接仍可用，请修复网络后重试）：{detail}")
except Exception as e:
    cloud_failed = True
    print(f"   ❌ 云端发布失败（家庭网链接仍可用，请确认 relay 在线后重试）：{e}")
finally:
    # #29（D-P2）：临时件清理（密钥必删；html 无敏感性一并收走，链接已打进输出）
    for p in (key_path, html_path):
        try:
            os.remove(p)
        except OSError:
            pass

if cloud_failed:
    sys.exit(1)
