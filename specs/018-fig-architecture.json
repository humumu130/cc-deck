  "cards": [
    {
      "dot": "cyan",
      "title": "信任边界",
      "items": [
        "云桥只传 E2E 密文，业务命令在源 relay 鉴权、幂等、执行",
        "三出口（LAN / 云桥 / WAN）同源快照，客户端皆投影",
        "ZCode unsupported · fail-closed",
        "Claude/Codex 专用适配路径"
      ]
    },
    {
      "dot": "amber",
      "title": "事实源与投影",
      "items": [
        "events.ndjson 是唯一事实源，状态不清先查事件与 ACK",
        "org / task-store / artifact 各自独立，不并库"
      ]
    },
    {
      "dot": "violet",
      "title": "会话卡编制",
      "items": [
        "PM 常驻重角色：分诊 / 任务书 / 派单 / 验收链 / 代提交 / rescue",
        "评审卡临时专家，跑完即删；worker 实施自查回单",
        "PM 派单 / worker 回单全流程见协作图（图 3）"
      ]
    }
  ]
