{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "混编团队协作工作流程（更新版）",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "legend": { "mode": "hidden" },
    "output": "specs/017-team-collab-flow.html"
  },
  "lanes": [
    { "id": "user", "label": "用户 · whether 拍板" },
    { "id": "lead", "label": "指挥链 · 架构师 + Leader" },
    { "id": "worker", "label": "Worker 池 · 实现" }
  ],
  "phases": [
    { "id": "p-intake", "label": "接诊 · 立项 · 任务书", "fromCol": 0, "toCol": 2 },
    { "id": "p-exec", "label": "派发 · 实现 · 核验", "fromCol": 3, "toCol": 4, "variant": "emphasis" },
    { "id": "p-close", "label": "交付验收", "fromCol": 5, "toCol": 5, "variant": "dashed" }
  ],
  "mainPath": ["demand", "triage", "confirm", "spec", "intake", "dispatch", "worker", "callback", "verify", "commit", "accept"],
  "semanticChecks": {
    "allowedRoots": ["demand"],
    "allowedTerminals": ["accept", "hold"],
    "requiredEdges": [
      { "from": "triage", "to": "hold" },
      { "from": "verify", "to": "rework" },
      { "from": "rework", "to": "worker" }
    ]
  },
  "nodes": [
    { "id": "demand", "lane": "user", "col": 0, "type": "security", "label": "一句话需求", "sublabel": "不挑粒度 · 唯一入口" },
    { "id": "triage", "lane": "lead", "col": 0, "type": "backend", "label": "Leader 分诊", "sublabel": "五响应 · 四档+暂缓" },
    { "id": "confirm", "lane": "user", "col": 1, "type": "security", "label": "立项确认卡", "sublabel": "正经必经 · 首次轻立项", "tag": "whether" },
    { "id": "spec", "lane": "lead", "col": 1, "type": "frontend", "label": "架构师任务书", "sublabel": "五要素 + 批次拆解", "tag": "what&how" },
    { "id": "intake", "lane": "lead", "col": 2, "type": "backend", "label": "核验入库", "sublabel": "spec 审读 · 批次入板" },
    { "id": "hold", "lane": "worker", "col": 1, "type": "database", "label": "建议暂缓", "sublabel": "一句理由 + 解除条件" },
    { "id": "dispatch", "lane": "lead", "col": 3, "type": "backend", "label": "逐单派发", "sublabel": "熟手查表 + 技能标签", "tag": "who&when" },
    { "id": "worker", "lane": "worker", "col": 3, "type": "cloud", "label": "Worker 实现", "sublabel": "引擎池 6 家 · 难度升档" },
    { "id": "callback", "lane": "worker", "col": 4, "type": "cloud", "label": "完成回调", "sublabel": "三端通知 · 失败注入" },
    { "id": "verify", "lane": "lead", "col": 4, "type": "backend", "label": "核验三件套", "sublabel": "diff + 探针 + 回归" },
    { "id": "commit", "lane": "worker", "col": 5, "type": "cloud", "label": "板卡收口", "sublabel": "任务板 done · 逐笔提交" },
    { "id": "rework", "lane": "lead", "col": 5, "type": "messagebus", "label": "回炉单", "sublabel": "带根因 · fix1/fix2" },
    { "id": "accept", "lane": "user", "col": 5, "type": "security", "label": "验收单收口", "sublabel": "转述成果 · 回填闭环", "tag": "whether" }
  ],
  "edges": [
    { "from": "demand", "to": "triage" },
    { "from": "triage", "to": "confirm", "label": "出确认卡" },
    { "from": "confirm", "to": "spec", "label": "用户 ✓", "variant": "emphasis" },
    { "from": "spec", "to": "intake", "label": "交付拆批" },
    { "from": "intake", "to": "dispatch" },
    { "from": "dispatch", "to": "worker", "label": "org dispatch" },
    { "from": "worker", "to": "callback" },
    { "from": "callback", "to": "verify", "label": "回执 + diff" },
    { "from": "verify", "to": "commit", "label": "全绿", "variant": "emphasis" },
    { "from": "commit", "to": "accept", "label": "转述 + 验收单" },
    { "from": "triage", "to": "hold", "label": "时机不对", "role": "branch", "variant": "dashed" },
    { "from": "verify", "to": "rework", "label": "真缺陷", "role": "error", "variant": "security" },
    { "from": "rework", "to": "worker", "label": "回炉返工", "role": "return", "variant": "dashed" }
  ],
  "cards": [
    { "dot": "cyan", "title": "三权分立 · 任务书纪律", "items": ["架构师定 what&how：任务书与批次拆解", "Leader 定 who&when：调度与核验把关", "用户定 whether：确认卡与验收拍板", "五要素：P 级、复现、根因、要求、断言", "验收可断言：选择器 + 期望值同源"] },
    { "dot": "violet", "title": "模型分层 · 调度并发", "items": ["6 家引擎池：角色 → 引擎映射配置", "难度升档：轻任务低配起，实锤再升", "熟手双来源调度：路由表记忆 + 编制门", "插单排队：在跑回合收口后注入", "扩编触发：首选次优皆忙且活不过夜"] },
    { "dot": "rose", "title": "核验与回调闭环", "items": ["DISPATCH_DONE 帧：三端齐通知", "failed 注入 Leader：重派换人或放弃", "FAIL 三问：口径、可见、正解", "视觉关卡：多模态复审 + 源码探针", "边界显式写；fix1/fix2 带根因回炉"] }
  ]
}
