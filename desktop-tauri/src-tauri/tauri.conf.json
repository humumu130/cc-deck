{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CC Deck Tauri",
  "version": "../package.json",
  "identifier": "online.humumu.ccdeck.tauri",
  "build": {
    "frontendDist": "../../web-console"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CC Deck",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "create": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "resources": [
      "resources/relay.mjs",
      "resources/bin/inject.cs"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJFNEE5MkQyRDE0QjlCNUEKUldSYW0wdlIwcEpLdnZOdldlUzh2a29VYmlsYnNLdEJCQWdSWm4wRnd2NkMrZlE3L3c5aTdRYm8K",
      "endpoints": [
        "https://github.com/humumu130/cc-deck/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}