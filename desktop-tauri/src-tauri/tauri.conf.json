{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CC Deck",
  "version": "../package.json",
  "identifier": "online.humumu.ccdeck.tauri",
  "build": {
    "frontendDist": "../../web-console"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CC Deck",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "create": false,
        "decorations": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis", "dmg", "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/relay.mjs": "resources/relay.mjs",
      "resources/bin/inject.cs": "resources/bin/inject.cs",
      "../../web-console/index.html": "web-console/index.html",
      "../../web-console/nacl.js": "web-console/nacl.js",
      "../../web-console/qr.js": "web-console/qr.js",
      "../../web-console/manifest.json": "web-console/manifest.json",
      "../../web-console/apple-touch-icon.png": "web-console/apple-touch-icon.png",
      "../../web-console/icon-192.png": "web-console/icon-192.png",
      "../../web-console/icon-512.png": "web-console/icon-512.png",
      "../../web-console/maskable-512.png": "web-console/maskable-512.png",
      "../../mobile/index.html": "mobile/index.html",
      "../../mobile/manifest.webmanifest": "mobile/manifest.webmanifest",
      "../../mobile/sw.js": "mobile/sw.js",
      "../../mobile/icon-192.png": "mobile/icon-192.png",
      "../../mobile/icon-512.png": "mobile/icon-512.png"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJFNEE5MkQyRDE0QjlCNUEKUldSYW0wdlIwcEpLdnZOdldlUzh2a29VYmlsYnNLdEJCQWdSWm4wRnd2NkMrZlE3L3c5aTdRYm8K",
      "endpoints": [
        "https://cc.humumu.online/download/tauri-latest.json",
        "https://github.com/humumu130/cc-deck/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}