    {
      "id": "receipt-ledger",
      "from": "receipt",
      "to": "ledger",
      "label": "append 落账",
      "variant": "default",
      "role": "return"
    },
    {
      "id": "ledger-memory",
      "from": "ledger",
      "to": "memory",
