    },
    {
      "id": "triage-errand",
      "from": "triage",
      "to": "errand",
      "label": "30 秒级 · 零确认",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "triage-light",
      "from": "triage",
      "to": "light",
      "label": "小功能 · 同类免确认",
      "variant": "dashed",
      "role": "branch",
      "route": "drop"
    },
    {
      "id": "triage-defer",
      "from": "triage",
      "to": "defer",
