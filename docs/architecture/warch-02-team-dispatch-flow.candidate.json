{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "cc-deck 团队模式 · 分诊派单协作流程",
    "locale": "zh-CN",
    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "user",
      "label": "用户 · whether 拍板"
    },
    {
      "id": "leader",
      "label": "Leader · 指挥链"
    },
    {
      "id": "relay",
      "label": "Relay · 状态机与账本"
    },
    {
      "id": "worker",
      "label": "Worker 池 · 多引擎"
    }
  ],
  "phases": [
    {
      "id": "p-intake",
      "label": "接诊 · 立项",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "p-exec",
      "label": "派发 · 执行",
      "fromCol": 2,
      "toCol": 3,
      "variant": "emphasis"
    },
    {
      "id": "p-close",
      "label": "收口 · 验收",
      "fromCol": 4,
      "toCol": 5,
      "variant": "dashed"
    }
  ],
  "groups": [
    {
      "id": "g-dispatch",
      "label": "派单状态机 · relay 写流转",
      "lane": "relay",
      "fromCol": 3,
      "toCol": 4,
      "variant": "emphasis"
    }
  ],
  "mainPath": [
    "demand",
    "triage",
    "confirm",
    "spec",
    "board",
    "dispatch",
    "running",
    "work",
    "close",
    "verify",
    "accept"
  ],
  "semanticChecks": {
    "allowedRoots": [
      "demand"
    ],
    "allowedTerminals": [
      "accept",
      "hold"
    ],
    "requiredEdges": [
      {
        "from": "triage",
        "to": "hold"
      },
      {
        "from": "verify",
        "to": "rework"
      },
      {
        "from": "rework",
        "to": "work"
      }
    ]
  },
  "nodes": [
    {
      "id": "demand",
      "lane": "user",
      "col": 0,
      "type": "security",
      "label": "一句话需求",
      "sublabel": "不挑粒度 · 唯一入口",
      "width": 150
    },
    {
      "id": "triage",
      "lane": "leader",
      "col": 0,
      "type": "backend",
      "label": "Leader 分诊",
      "sublabel": "四档+暂缓 · 看门狗",
      "width": 150
    },
    {
      "id": "hold",
      "lane": "relay",
      "col": 0,
      "type": "database",
      "label": "建议暂缓",
      "sublabel": "时机不对 · 点头挂起",
      "width": 150
    },
    {
      "id": "confirm",
      "lane": "user",
      "col": 1,
      "type": "security",
      "label": "立项确认卡",
      "sublabel": "正经每次 · 轻立项首次",
      "tag": "whether",
      "width": 150
    },
    {
      "id": "spec",
      "lane": "leader",
      "col": 1,
      "type": "frontend",
      "label": "自包含任务书",
      "sublabel": "五要素 · 验收点",
      "tag": "what&how",
      "width": 150
    },
    {
      "id": "board",
      "lane": "relay",
      "col": 1,
      "type": "database",
      "label": "任务板入库",
      "sublabel": "boards/<gid>.json",
      "tag": "批次拆解",
      "width": 150
    },
    {
      "id": "dispatch",
      "lane": "leader",
      "col": 2,
      "type": "backend",
      "label": "org dispatch 派单",
      "sublabel": "熟手+技能标签",
      "tag": "who&when",
      "width": 150
    },
    {
      "id": "running",
      "lane": "relay",
      "col": 3,
      "type": "backend",
      "label": "拉起 Worker",
      "sublabel": "板卡 → doing"
    },
    {
      "id": "work",
      "lane": "worker",
      "col": 3,
      "type": "cloud",
      "label": "Worker 执行",
      "sublabel": "引擎池 · 回执含 diff+探针",
      "width": 170
    },
    {
      "id": "close",
      "lane": "relay",
      "col": 4,
      "type": "backend",
      "label": "派单收口",
      "sublabel": "done|failed · 板卡同步",
      "width": 104
    },
    {
      "id": "verify",
      "lane": "leader",
      "col": 4,
      "type": "backend",
      "label": "核验三件套",
      "sublabel": "diff+探针+回归",
      "width": 130
    },
    {
      "id": "rework",
      "lane": "leader",
      "col": 5,
      "type": "messagebus",
      "label": "回炉单",
      "sublabel": "带根因 · fix1/fix2",
      "width": 160
    },
    {
      "id": "accept",
      "lane": "user",
      "col": 5,
      "type": "security",
      "label": "验收收口",
      "sublabel": "验收单回填 · 可结项",
      "tag": "whether",
      "width": 190
    }
  ],
  "edges": [
    {
      "id": "e-demand-triage",
      "from": "demand",
      "to": "triage"
    },
    {
      "id": "e-triage-confirm",
      "from": "triage",
      "to": "confirm",
      "label": "出确认卡"
    },
    {
      "id": "e-triage-hold",
      "from": "triage",
      "to": "hold",
      "role": "branch",
      "variant": "dashed"
    },
    {
      "id": "e-confirm-spec",
      "from": "confirm",
      "to": "spec",
      "label": "用户 ✓",
      "variant": "emphasis"
    },
    {
      "id": "e-spec-board",
      "from": "spec",
      "to": "board"
    },
    {
      "id": "e-board-dispatch",
      "from": "board",
      "to": "dispatch",
      "label": "领单"
    },
    {
      "id": "e-dispatch-running",
      "from": "dispatch",
      "to": "running",
      "label": "org dispatch"
    },
    {
      "id": "e-running-work",
      "from": "running",
      "to": "work",
      "label": "spawn · doing"
    },
    {
      "id": "e-work-close",
      "from": "work",
      "to": "close",
      "label": "回合结束 · 回执"
    },
    {
      "id": "e-close-verify",
      "from": "close",
      "to": "verify",
      "label": "done + 回执"
    },
    {
      "id": "e-verify-accept",
      "from": "verify",
      "to": "accept",
      "label": "全绿 · 转述",
      "variant": "emphasis"
    },
    {
      "id": "e-verify-rework",
      "from": "verify",
      "to": "rework",
      "label": "真缺陷",
      "role": "error",
      "variant": "security"
    },
    {
      "id": "e-rework-work",
      "from": "rework",
      "to": "work",
      "label": "回炉重派",
      "role": "return",
      "variant": "dashed"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "组织与项目组三态",
      "items": [
        "Leader 常驻 · CLAUDE.md + dispatch-log 双账本",
        "在办 ⇄ 挂起 → 结项（可复活）· 上限 5 组",
        "非在办板冻结 · 2 周闲置自动建议挂起"
      ]
    },
    {
      "dot": "violet",
      "title": "分诊四档 + 第五态",
      "items": [
        "咨询 / 随手办 / 轻立项 / 正经立项 + 暂缓",
        "确认门随档收严 · 升降级须理由 + 确认卡",
        "熟手双来源调度 · 技能标签 · 插单排队"
      ]
    },
    {
      "dot": "rose",
      "title": "派单状态机",
      "items": [
        "dispatched → running → done|failed · relay 写流转",
        "收口五源：回合尾 / 删会话 / 退休 / 归档 / 重启",
        "板卡自动流转 · lessons 回流 · failed 注入 Leader"
      ]
    }
  ]
}